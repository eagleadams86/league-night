rules_version = '2';

// Security rules for League Night's Firestore database.
//
// This file is a checked-in copy of what should be deployed in the Firebase
// console (Firestore Database → Rules). Nothing in this repo deploys it — there
// is no Firebase CLI setup here and the app is a single static page — so if the
// rules are ever changed in the console, update this file to match. (Same
// pattern as the golf-handicap, paptrack and financial-plan repos.)
//
// THE 2026-09-10 CLUB/LEAGUE SPLIT IS AN ADDITIVE DEPLOY: `game` became
// optional, its immutability check went, and `validSize` gained a GUARDED
// `leagues` cap. Every rule here is strictly more permissive than the one it
// replaces, so a client still on the old build is refused nothing. Put it up
// before the app all the same — that is the standing order and it costs nothing.
//
// PASTE THESE INTO THE CONSOLE BEFORE SIGNING IN FOR THE FIRST TIME. Firestore's
// default rules for a new project either deny everything (sync silently fails)
// or, in test mode, allow every signed-in user to read and write everything.
//
// THIS IS THE FIRST APP IN THE FAMILY WHOSE DOCUMENTS ARE SHARED. Every sibling
// keeps one private document per account; here a league is one document many
// accounts can read and a few can write. The model, in one paragraph:
//
//   * Knowing a League ID is the READ capability. Any signed-in account can
//     `get` a league by its id, and NOBODY can `list` the collection — that is
//     what makes an unguessable id a capability rather than a hint.
//   * Presenting the Admin Key is the WRITE capability. It lives in a document
//     nobody can read (`private/admin`); an account claims admin by writing the
//     key it was given into its own write-only mailbox (`claims/{uid}`) and
//     asking for the admin role — the rules compare the two on the server.
//   * The OWNER is a field on the league document. Only the owner can change it,
//     and only to an existing member; only the owner rotates the key, promotes,
//     demotes or removes members, or deletes the league.
//   * Every update must raise `rev` by exactly one, which makes "every write is
//     a transaction" a fact the server checks, not a habit the client keeps.
//
// EVERY get() IS GUARDED BY exists(). An unguarded get() on a missing document
// is an evaluation ERROR, not `false`; an `||` chain forgives that error only
// when its other side is true, so the outcome would depend on evaluation order
// and every test in the Rules Playground would show an error. Access-call
// budget: the worst case below makes four of the ten a request may make.
//
// Rules do NOT cascade to subcollections: a match on /leagues/{id} says nothing
// about /leagues/{id}/members. Each block below is needed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me()       { return request.auth.uid; }

    match /leagues/{leagueId} {
      function leaguePath()    { return /databases/$(database)/documents/leagues/$(leagueId); }
      function memberPath(uid) { return /databases/$(database)/documents/leagues/$(leagueId)/members/$(uid); }
      function claimPath()     { return /databases/$(database)/documents/leagues/$(leagueId)/claims/$(me()); }
      function keyPath()       { return /databases/$(database)/documents/leagues/$(leagueId)/private/admin; }

      // Used by the SUBCOLLECTION rules, where the league is not `resource`.
      function isOwner()       { return signedIn() && exists(leaguePath()) && get(leaguePath()).data.owner == me(); }
      function memberIsAdmin() { return signedIn() && exists(memberPath(me())) && get(memberPath(me())).data.role == 'admin'; }
      function keyMatches()    { return signedIn() && exists(claimPath()) && exists(keyPath())
                                        && get(claimPath()).data.key == get(keyPath()).data.key; }

      // What ONE league may hold. NOT a size guarantee: a Firestore document is
      // capped at 1 MiB and the app already warns past 600 KB and meters against
      // 1,000 KB, so a league of live-scored legs meets that limit long before
      // any count here. What these bound is the COUNT, so that no single write
      // can hand every member's browser a million-element list to normalize and
      // draw. Every number is far above any real pub league and far below
      // anything a script would want: a 20-side double round robin is 380
      // fixtures a season, so 2,000 matches is five such seasons.
      //
      // `size()` on a non-list is an evaluation ERROR, which denies — so
      // `d.state is map` must stay ahead of this, and a hostile write missing
      // one of the six unguarded keys is refused rather than let through. The
      // seventh, `leagues`, is guarded instead — see the line itself.
      function validSize(s) {
        return s.players.size()    <= 500
            && s.teams.size()      <= 250
            && s.seasons.size()    <= 100
            && s.matches.size()    <= 2000
            && s.brackets.size()   <= 200
            && s.tombstones.size() <= 2000
            // `leagues` — the competitions this club runs — arrived with the
            // club/league split. GUARDED, and that is not decoration: size() on
            // a map without the key is an evaluation ERROR, which denies, so an
            // unconditional clause here would refuse every write from a client
            // that has not upgraded yet. 50 is per CLUB and is a different
            // number from LEAGUES_MAX in the app, which is clubs per ACCOUNT.
            && (!('leagues' in s) || s.leagues.size() <= 50);
      }

      // `hasAll` and NOT `hasOnly`, which is what lets a league written before
      // Team Setup existed still validate with no `setup` key at all.
      function validLeague(d) {
        return d.keys().hasAll(['state', 'rev', 'owner', 'name', 'schema', 'updatedAt'])
          && d.owner is string && d.rev is int && d.rev >= 0 && d.schema is int
          && d.name is string && d.name.size() <= 40
          // `game` was required until the club/league split: one document was
          // one group of people at ONE game. A club runs several, so the field
          // has no single answer any more and new clubs are written without it.
          // OPTIONAL rather than removed — `hasAll` and not `hasOnly` means
          // every document written before the split still carries one and must
          // still validate. Same treatment as `setup` below.
          && (!('game' in d) || (d.game is string && d.game.size() <= 20))
          && d.state is map && d.updatedAt is number
          && (!('setup' in d) || d.setup is bool)
          && validSize(d.state);
      }

      allow get:    if signedIn();          // knowing the ID is the read capability
      allow list:   if false;               // the ID must never be enumerable
      allow create: if signedIn() && validLeague(request.resource.data)
                    && request.resource.data.owner == me() && request.resource.data.rev == 0;
      allow update: if signedIn() && validLeague(request.resource.data)
                    && request.resource.data.rev == resource.data.rev + 1
                    && (
                         // the owner: anything, and may hand ownership to an existing member
                         (resource.data.owner == me()
                          && (request.resource.data.owner == resource.data.owner
                              || exists(memberPath(request.resource.data.owner))))
                         // an admin: anything except the owner field
                      || (request.resource.data.owner == resource.data.owner && memberIsAdmin())
                         // A MEMBER, and only while Team Setup is open. The two
                         // diffs below are the WHOLE of what the server can
                         // promise: the document changes only `state`, `rev` and
                         // `updatedAt`, and inside `state` only the players, the
                         // teams and the tombstones. No result, no fixture, no
                         // season, no bracket and no league setting can move.
                         //
                         // It cannot say WHICH player. Rules compare whole
                         // lists — there is no per-element diff — so a member
                         // who went digging could rename or move somebody else
                         // during setup. The UI is what keeps it to teams and
                         // their own membership, and CLAUDE.md records the trade.
                         //
                         // diff().affectedKeys() and not four `==` comparisons:
                         // the document-level diff pins `owner`, `name`,
                         // `schema` AND `setup` in one expression (a member
                         // cannot flip their own gate), the state-level diff pins
                         // `club` AND `leagues` whole — every league's settings
                         // included, because an unequal nested map is a changed
                         // key — and refuses a new key besides. The list below
                         // is what a member MAY move; a league is not on it, so
                         // creating, renaming or re-gaming one is denied here
                         // with no clause of its own. Four list equalities would walk `matches`
                         // element by element and push a big league against the
                         // per-request expression budget, failing in a way
                         // nobody can read.
                         //
                         // get('setup', false): an ABSENT flag reads as off, so
                         // nothing widens for a league that already existed.
                      || (resource.data.get('setup', false) == true
                          && exists(memberPath(me()))
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['state', 'rev', 'updatedAt'])
                          && request.resource.data.state.diff(resource.data.state).affectedKeys()
                               .hasOnly(['players', 'teams', 'tombstones']))
                    );
      allow delete: if signedIn() && resource.data.owner == me();

      // The Admin Key. The owner may read it back (a new phone has no other way
      // to show it); nobody else may read it at all.
      match /private/admin {
        allow read:   if isOwner();
        allow create, update: if isOwner()
                              && request.resource.data.keys().hasOnly(['key'])
                              && request.resource.data.key is string
                              && request.resource.data.key.size() == 16;
        allow delete: if isOwner();
      }

      // A write-only mailbox: an account presents the key it was given here,
      // and the member rule below compares it with the real one. Never readable,
      // and deleted by the client once the claim has gone through.
      match /claims/{uid} {
        allow read:   if false;
        allow create, update: if signedIn() && me() == uid
                              && request.resource.data.keys().hasOnly(['key', 'at'])
                              && request.resource.data.key is string
                              && request.resource.data.key.size() <= 32;
        allow delete: if signedIn() && (isOwner() || me() == uid);
      }

      // Who is in the league and what they may do. Readable by anyone signed in
      // (a roster is not a secret to the people in it); an account may add
      // itself as a viewer, or as an admin when its claim matches the key; the
      // OWNER may add itself as an admin outright (sharing a league writes the
      // owner's own record, and the owner never presents a key — the first
      // published version forgot this and every Share stopped halfway); the
      // owner may set anyone's role or remove anyone; anyone may leave.
      match /members/{uid} {
        // `avail` is what this account has said about ITSELF — which nights it
        // can play, keyed by date. It rides on the member document and not in
        // the league because it needs no admin: the self-update clause below
        // (own uid, role unchanged) is what already lets a viewer set playerId,
        // and it lets them set this too. Capped at 40 nights so a member
        // document cannot grow without bound, and to three answers so a value
        // reaching another player's screen can only be one of three words.
        function validMember(d) {
          return d.keys().hasOnly(['role', 'name', 'playerId', 'joinedAt', 'avail'])
            && d.role in ['admin', 'viewer']
            && d.name is string && d.name.size() <= 40
            && (!('playerId' in d) || (d.playerId is string && d.playerId.size() <= 64))
            && (!('avail' in d) || (d.avail is map && d.avail.size() <= 40
                                    && d.avail.values().hasOnly(['y', 'n', 's'])));
        }
        allow read:   if signedIn();
        allow create: if signedIn() && me() == uid && exists(leaguePath())
                      && validMember(request.resource.data)
                      && (request.resource.data.role == 'viewer' || keyMatches() || isOwner());
        allow update: if signedIn() && validMember(request.resource.data) && (
                         isOwner()
                      || (me() == uid && request.resource.data.role == resource.data.role)
                      || (me() == uid && request.resource.data.role == 'admin' && keyMatches())
                         // An ADMIN may say which player another account is, and
                         // NOTHING else about them: affectedKeys().hasOnly is
                         // stronger than three equalities — it covers `joinedAt`
                         // and refuses a new key too. One predicate away from
                         // nothing, and deliberately NOT one predicate away from
                         // an admin writing a `role`, which is the trap recorded
                         // for the request queue below.
                      || (memberIsAdmin()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerId'])));
        allow delete: if signedIn() && (isOwner() || me() == uid);
      }

      // A member's PROPOSAL, and the ONLY way anything they type reaches the
      // league. The league document is one map to these rules — they can say
      // "may write all of it" or "none of it", never "may write their own
      // name" — so a member writes what they are asking for here, and an
      // admin's tap is what applies it through the ordinary save path. What
      // lands here has authority over nothing until then.
      //
      // Note `list` is allowed where it is false on /leagues, and the
      // difference is the id: a League ID is a capability, a uid is not, and
      // /members is already listable and hands out every uid in the league.
      // Only somebody who could act on a request carries the listener.
      match /requests/{uid} {
        function validRequest(d) {
          return d.keys().hasOnly(['at', 'playerId', 'name', 'teamId', 'teamName', 'claim'])
            && d.at is number
            && (('name' in d) || ('teamName' in d) || ('claim' in d))
            && (!('name' in d)     || (d.name is string && d.name.size() > 0 && d.name.size() <= 40))
            && (!('teamName' in d) || (d.teamName is string && d.teamName.size() > 0 && d.teamName.size() <= 40))
            && (!('playerId' in d) || (d.playerId is string && d.playerId.size() <= 64))
            && (!('teamId' in d)   || (d.teamId is string && d.teamId.size() <= 64))
            // `claim` is "I am this player" — the ask that has no other route
            // once Team Setup has closed.
            && (!('claim' in d)    || (d.claim is string && d.claim.size() <= 64));
        }
        allow get:    if signedIn() && (me() == uid || memberIsAdmin() || isOwner());
        allow list:   if signedIn() && (memberIsAdmin() || isOwner());
        // exists(memberPath(me())): only somebody who has actually JOINED may
        // file, so knowing the League ID is not enough to fill the queue.
        allow create, update: if signedIn() && me() == uid
                              && exists(leaguePath()) && exists(memberPath(me()))
                              && validRequest(request.resource.data);
        // Withdrawing your own and an admin dismissing it are the same act.
        allow delete: if signedIn() && (me() == uid || memberIsAdmin() || isOwner());
      }

      // ── One account per player, one player per account ─────────────────────
      // THE DOCUMENT ID IS THE PLAYER'S ID, and that is the whole index: two
      // accounts cannot both hold one player, because the second create fails.
      // The other half of the invariant is the MEMBER document, which has one
      // `playerId` field and therefore names one player. Between them the claim
      // is exclusive both ways.
      //
      //   SERVER-ENFORCED: at most one account per player (this collection),
      //     and at most one player per account (one field on one document).
      //   BY AGREEMENT: that the two name each other. Checked at CREATE and
      //     never after — a member may later re-point their own playerId and
      //     leave this row squatting. Which is why the client shows a claim only
      //     when BOTH say so, and why every half-written state reads as "not
      //     claimed" rather than as "claimed by two people".
      //
      // Create-only: switching is delete-then-create, so a swap is never one
      // write that could half-succeed into a lie. And the agreement is required
      // of EVERYONE — the last line is only about who may act — which is what
      // lets an admin assign somebody without a second branch. It makes the
      // write ORDER load-bearing: the member document first, then the row, or
      // the create is refused.
      match /roster/{playerId} {
        function claimant() { return request.resource.data.uid; }
        allow read:   if signedIn();          // every member draws the roster
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['uid', 'at'])
                      && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
                      && request.resource.data.at is number
                      && exists(memberPath(claimant()))
                      && get(memberPath(claimant())).data.playerId == playerId
                      && (claimant() == me() || isOwner() || memberIsAdmin());
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == me() || isOwner() || memberIsAdmin());
      }
    }

    // The family's per-account document: which leagues this account has
    // joined, and which of them it is in (`current`), so the leagues AND the
    // landing follow a Google account to a new phone. Ids and names only —
    // never a key. Nothing here is validated, so the app is the only thing
    // keeping a credential out of it; every write to it merges, because the
    // list and `current` are written on different schedules.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Everything else is denied by default: there is deliberately no
    // `match /{document=**}` catch-all, and the app touches no other path.
  }
}
